{
  "name": "account-manager-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --build",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply account-manager-demo --local",
    "verify": "run-s format:check lint type-check test build"
  },
  "engines": {
    "node": "^24.12.0"
  },
  "dependencies": {
    "hash-wasm": "4.12.0",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true
  }
}
